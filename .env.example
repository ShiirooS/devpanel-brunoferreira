# Copy to .env at the repo root:  cp .env.example .env
# Local development values only. Never commit a real .env.

# --- PostgreSQL (read by docker-compose.yml) ---
POSTGRES_USER=devpanel
POSTGRES_PASSWORD=devpanel
POSTGRES_DB=devpanel
# Host port mapped to the container's 5432. 5433 avoids clashing with a locally installed Postgres.
POSTGRES_PORT=5433

# --- Backend (NestJS + Prisma) ---
# Must match the PostgreSQL values above.
DATABASE_URL=postgresql://devpanel:devpanel@localhost:5433/devpanel?schema=public
PORT=3000
# HS256 secret used to sign session JWTs. Minimum 32 characters (validated at startup).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Session lifetime in seconds (JWT exp and cookie Max-Age). Set to 60 to demo the expired-session flow.
JWT_EXPIRES_IN_SECONDS=3600
